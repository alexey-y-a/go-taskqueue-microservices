# Порт сервера
PORT=8081

# Тип хранилища: memory или postgres
STORE_TYPE=postgres

# Настройки PostgreSQL (только если STORE_TYPE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=queue_service

# Таймауты сервера (в секундах)
READ_TIMEOUT=5
WRITE_TIMEOUT=10
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=10

# Уровень логирования (debug, info, warn, error)
LOG_LEVEL=info