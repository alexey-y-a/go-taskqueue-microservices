# Порт сервера
PORT=8082

# Таймауты сервера (в секундах)
READ_TIMEOUT=5
WRITE_TIMEOUT=10
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=10

# Настройки воркера
POLL_INTERVAL=5      # Интервал опроса очереди (секунды)
BATCH_SIZE=10        # Количество задач за раз

# Настройки клиента Queue Service
QUEUE_SERVICE_URL=http://localhost:8081

# Уровень логирования (debug, info, warn, error)
LOG_LEVEL=info