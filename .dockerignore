# Игнорируем при сборке Docker образа

# Git файлы
.git/
.gitignore

# Файлы IDE
.idea/
.vscode/
*.swp

# Логи
*.log

# Бинарники (не нужны, собираем заново)
/bin/
*.exe

# Временные файлы
*.tmp
*.temp

